{
  "manifest_version": 3,
  "name": "Scamlex Guard",
  "version": "2.2",
  "description": "Real-time scam protection while you browse.",

  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/Scamlex.png",
      "32": "icons/Scamlex.png",
      "48": "icons/Scamlex.png"
    }
  },

  "icons": {
    "16": "icons/Scamlex.png",
    "32": "icons/Scamlex.png",
    "48": "icons/Scamlex.png",
    "128": "icons/Scamlex.png"
  }
}
